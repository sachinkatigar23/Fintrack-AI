# ── Server ──
PORT=5000
# Address of the React app (comma-separate if you use more than one)
CLIENT_URL=http://localhost:5173

# ── Database ──
# Local MongoDB (default) or a MongoDB Atlas "mongodb+srv://..." string
MONGO_URI=mongodb://127.0.0.1:27017/fintrack

# ── JWT secrets (any long random text, keep private) ──
JWT_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret

# ── AI (Google Gemini) - optional, app works without it ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Cloudinary (receipt & avatar storage) - optional, files are kept locally without it ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (bill reminders, password reset) - optional, printed to console without it ──
# For Gmail use an "App password", not your normal password
EMAIL_USER=
EMAIL_PASS=
