# ── Server ──
PORT=5000
# Set to "production" on the host (Render). Then the server also serves the
# built React app (client/dist) and the refresh cookie is "secure".
# NODE_ENV=production

# Time zone for day boundaries ("today", streaks, safe-to-spend). The server
# defaults to Asia/Kolkata, but set TZ=Asia/Kolkata explicitly in production -
# Render servers run in UTC.
# TZ=Asia/Kolkata

# Address of the React app (comma-separate if you use more than one).
# In production this is the site's own URL, e.g. https://<name>.onrender.com
CLIENT_URL=http://localhost:5173

# Optional: DNS servers for the email-domain check, only if Node can't reach
# your system DNS locally (e.g. 1.1.1.1,8.8.8.8). Must stay EMPTY on Render.
DNS_SERVERS=

# ── Database ──
# Local MongoDB (default) or a MongoDB Atlas "mongodb+srv://..." string
MONGO_URI=mongodb://127.0.0.1:27017/fintrack

# ── JWT secrets (any long random text, keep private) ──
JWT_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret

# ── AI (Google Gemini) - optional, app works without it ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Cloudinary (receipt & avatar storage) - optional, files are kept locally without it ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (verification codes, alerts, reminders) - optional, printed to console without it ──
# Provider order: BREVO_API_KEY (HTTPS API) -> EMAIL_USER/EMAIL_PASS (SMTP) -> console.

# Brevo (brevo.com) email API - use this in production: Render's free plan
# blocks SMTP. EMAIL_FROM must be a sender address verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=FinTrack AI

# SMTP via nodemailer - fine for local development (not on Render).
# For Gmail use an "App password", not your normal password
EMAIL_USER=
EMAIL_PASS=
